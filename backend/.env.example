# ── Copy this to .env and fill in values ─────────────────────────────────────
# cp .env.example .env

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-32-char-string-in-production

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev (bare metal):
REDIS_URL=redis://localhost:6379/0
# Docker Compose (backend service talks to redis service):
# REDIS_URL=redis://redis:6379/0

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev — swap to postgres+asyncpg for production
DATABASE_URL=sqlite+aiosqlite:///./pricing_engine.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pricing_engine

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Pricing Rules (override defaults) ────────────────────────────────────────
MIN_MARGIN_PCT=0.10
MAX_DISCOUNT_PCT=0.40
MAX_SURGE_PCT=0.25

# ── A/B Testing ───────────────────────────────────────────────────────────────
AB_ENABLED=true
AB_SALT=pricing-ab-2024-change-me

# ── ML Models (optional — engine works without them) ─────────────────────────
# GRU_MODEL_PATH=ml/models/gru4rec.pt
# CF_MODEL_PATH=ml/models/cf_model.pkl

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_NAME=FlowPriceAI Deals